# Copy to .env and adjust. Defaults work with `docker compose up db`.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finance_demo

# Agent mode: "mock" (default, offline, no key needed) or "gemini".
AGENT_MODE=mock

# Only needed for AGENT_MODE=gemini. A free-tier key from
# https://aistudio.google.com/apikey is enough - no paid plan required.
# Never commit a real key.
GEMINI_API_KEY=
